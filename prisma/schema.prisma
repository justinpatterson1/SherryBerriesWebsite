// SherryBerries Prisma schema
// References:
//   - context/project-overview.md (data models)
//   - context/backend-architecture.md
//   - context/database-spec.md
//
// Prisma 7: uses the new `prisma-client` generator (output path is required).
// PrismaClient must be instantiated with a driver adapter (see src/lib/db/index.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
  SUPERADMIN
}

enum JewelryType {
  BELLY_RING
  NOSE_RING
  SEPTUM
  CARTILAGE
  NIPPLE
  EAR_LOBE
  INDUSTRIAL
  LABRET
  AFTERCARE
  ELIXIR
}

enum HealingStage {
  FRESH_PIERCING
  HEALING
  HEALED
}

/// Payment lifecycle, tracked separately from FulfillmentStatus because the
/// two genuinely diverge: a Cash-on-Delivery order can be PROCESSING while
/// still AWAITING_PAYMENT.
///
/// The four original values are kept rather than renamed to the bank-transfer
/// spec's wording. PENDING in particular is load-bearing: the WiPay callback
/// gates its idempotency on it, so a replayed callback cannot re-send a
/// confirmation email or double-restock. Renaming it would have broken that
/// silently. The new values are additive and used only by bank transfer.
enum PaymentStatus {
  /// Card/COD orders awaiting resolution. Also WiPay's replay guard.
  PENDING
  PAID
  FAILED
  REFUNDED
  /// Bank transfer: order placed, money not yet sent.
  AWAITING_PAYMENT
  /// Bank transfer: the customer uploaded a receipt. NOT proof of payment —
  /// only an admin who checked the bank account may move this to PAID.
  PAYMENT_SUBMITTED
  /// Bank transfer: an admin reviewed the receipt and did not accept it.
  REJECTED
  /// Bank transfer: the payment window closed with no receipt submitted.
  EXPIRED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Lifecycle of a customer's return request. REJECTED is the dead end;
/// REFUNDED is the only successful terminal state.
enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

// -----------------------------------------------------------------------------
// Auth (NextAuth v5 / @auth/prisma-adapter contract)
// -----------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// Users
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  firstName     String?
  lastName      String?
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phoneNumber   String?
  role          UserRole  @default(CUSTOMER)
  avatarUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  addresses      Address[]
  orders         Order[]
  reviews        Review[]
  returnRequests ReturnRequest[]
  wishlistItems  Wishlist[]
  cart           Cart?

  @@index([email])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  fullName     String
  phoneNumber  String
  addressLine1 String
  addressLine2 String?
  city         String
  region       String
  postalCode   String?
  country      String
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -----------------------------------------------------------------------------
// Catalog
// -----------------------------------------------------------------------------

model Category {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  description    String?
  imageUrl       String?
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  shortDescription  String
  description       String        @db.Text
  sku               String        @unique
  price             Decimal       @db.Decimal(10, 2)
  compareAtPrice    Decimal?      @db.Decimal(10, 2)
  inventory         Int           @default(0)
  lowStockThreshold Int           @default(5)
  featured          Boolean       @default(false)
  active            Boolean       @default(true)
  material          String?
  jewelryType       JewelryType
  healingStage      HealingStage?
  seoTitle          String?
  seoDescription    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images         ProductImage[]
  variants       ProductVariant[]
  reviews        Review[]
  wishlistItems  Wishlist[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  tags           ProductTag[]

  @@index([categoryId])
  @@index([slug])
  @@index([active, featured])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  name            String
  value           String
  sku             String   @unique
  inventory       Int      @default(0)
  additionalPrice Decimal? @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model ProductTag {
  id   String @id @default(cuid())
  name String @unique

  products Product[]
}

// -----------------------------------------------------------------------------
// Cart
// -----------------------------------------------------------------------------

model Cart {
  id     String  @id @default(cuid())
  userId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([cartId])
  @@index([productId])
}

// -----------------------------------------------------------------------------
// Orders
// -----------------------------------------------------------------------------

/// One uploaded proof-of-payment file. History is kept rather than
/// overwritten: a rejected receipt is part of why an order was refused, and
/// a customer may legitimately resubmit after getting the amount wrong.
enum ReceiptStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

/// Proof of payment for a bank transfer order.
///
/// `fileKey` is the object key in the PRIVATE bucket, never a public URL —
/// receipts are customer financial documents and are served only through a
/// route that checks the viewer owns the order or is an admin.
model PaymentReceipt {
  id       String @id @default(cuid())
  orderId  String
  fileKey  String
  fileType String
  fileSize Int

  status     ReceiptStatus @default(SUBMITTED)
  uploadedAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model Order {
  id                String            @id @default(cuid())
  userId            String
  orderNumber       String            @unique
  subtotal          Decimal           @db.Decimal(10, 2)
  shippingCost      Decimal           @db.Decimal(10, 2)
  total             Decimal           @db.Decimal(10, 2)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  paymentMethod     String?
  trackingNumber    String?
  notes             String?

  /// Bank transfer only. When the reservation lapses; null for every other
  /// method. An order whose payment is PAYMENT_SUBMITTED is never expired on
  /// this timestamp — a receipt filed before the deadline waits for review.
  paymentExpiresAt DateTime?
  /// Set when an admin confirms the money actually arrived.
  paymentVerifiedAt   DateTime?
  paymentVerifiedById String?
  /// Why a submitted receipt was refused, shown back to the customer.
  paymentRejectionReason String?

  /// Where this order actually shipped, captured at checkout.
  ///
  /// Snapshotted onto the order rather than read back through Address, because
  /// an address is mutable: reading the customer's current default made every
  /// past order appear to have shipped wherever they live now. Nullable because
  /// orders placed before these columns existed have no snapshot — the account
  /// view falls back to the JSON in `notes` for those.
  shipName     String?
  shipPhone    String?
  shipEmail    String?
  shipLine1    String?
  shipCity     String?
  shipLandmark String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  orderItems     OrderItem[]
  returnRequests ReturnRequest[]
  paymentReceipts PaymentReceipt[]

  @@index([userId])
  @@index([orderNumber])
  @@index([paymentStatus, fulfillmentStatus])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  returnRequests ReturnRequest[]

  @@index([orderId])
  @@index([productId])
}

/// A customer's request to return one item from one delivered order.
///
/// Scoped to a single OrderItem rather than a whole order because that is what
/// the customer picks in the form and what the Returns Policy describes — a
/// customer returning two items from one order opens two requests, each with
/// its own reference and outcome.
model ReturnRequest {
  id          String       @id @default(cuid())
  /// Customer-facing reference, e.g. RT-4821. Unique so it can be quoted.
  reference   String       @unique
  userId      String
  orderId     String
  orderItemId String
  /// One of RETURN_REASONS in lib/account/returns.ts, validated at the API.
  reason      String
  notes       String?      @db.Text
  status      ReturnStatus @default(REQUESTED)
  /// Set by an admin when approving or rejecting; shown to the customer.
  resolution  String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The product is reachable through orderItem, so it is not duplicated here.
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([orderId])
}

// -----------------------------------------------------------------------------
// Reviews + Wishlist
// -----------------------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?
  comment   String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, approved])
  @@index([userId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Content + marketing
// -----------------------------------------------------------------------------

model Blog {
  id             String  @id @default(cuid())
  title          String
  slug           String  @unique
  excerpt        String?
  content        String  @db.Text
  featuredImage  String?
  published      Boolean @default(false)
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

/// A newsletter signup. Kept in our own table rather than pushed straight to an
/// email provider, so the list survives changing provider and unsubscribing
/// works without an account.
///
/// Rows are never deleted on unsubscribe — `unsubscribedAt` is set instead, so
/// a later re-signup is a reactivation and there is a record of when consent
/// was given and withdrawn.
model NewsletterSubscriber {
  id String @id @default(cuid())
  /// Stored lowercased and trimmed; uniqueness is on that normalised form.
  email        String   @unique
  subscribedAt DateTime @default(now())
  /// Where the signup came from, e.g. "homepage".
  source String?
  /// Secret in the unsubscribe link, so the link identifies exactly one row.
  unsubscribeToken String    @unique
  unsubscribedAt   DateTime?

  @@index([unsubscribedAt])
}

/// Append-only record of every change an admin makes through the admin panel.
/// Rows are written inside the same transaction as the change they describe, so
/// a change cannot happen without being logged; nothing ever updates them, and
/// only the 12-month retention sweep deletes them.
///
/// Deliberately holds NO customer personal data. Order and return entries point
/// at the record by its number or reference — the customer's details already
/// live on that record, so the log never becomes a second copy of them.
///
/// There is no relation to User: the actor's email is copied in, so the log
/// still says who did something after that account is renamed or deleted.
model AdminAuditLog {
  id         String @id @default(cuid())
  actorId    String
  actorEmail String
  /// Verb, e.g. "order.status_change" or "category.delete".
  action String
  /// What was acted on, e.g. "Order" + the order's id.
  entityType String
  entityId   String
  /// Human-readable one-liner for the Activity screen.
  summary String
  /// Machine-readable detail, e.g. {"price":{"from":45,"to":39}}.
  changes Json?
  ip      String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model DiscountCode {
  id            String    @id @default(cuid())
  code          String    @unique
  percentageOff Int?
  amountOff     Decimal?  @db.Decimal(10, 2)
  active        Boolean   @default(true)
  usageLimit    Int?
  timesUsed     Int       @default(0)
  expiresAt     DateTime?

  createdAt DateTime @default(now())

  @@index([active, expiresAt])
}
